{
  "version": 2,
  "name": "nimfadora-tardis",
  "cleanUrls": true,
  "builds": [
    {
      "src": "api/settings.go",
      "use": "@vercel/go"
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/settings" },
    { "source": "/mcp", "destination": "/api/settings" },
    { "source": "/(.*)", "destination": "/api/settings" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
