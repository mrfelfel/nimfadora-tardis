{
  "version": 2,
  "name": "nimfadora-tardis",
  "cleanUrls": true,
  "builds": [
    {
      "src": "settings.go",
      "use": "@vercel/go",
      "config": {
        "includeFiles": ["dashboard.html"]
      }
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/settings" },
    { "source": "/mcp", "destination": "/settings" },
    { "source": "/(.*)", "destination": "/settings" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
